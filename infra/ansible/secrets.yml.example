# Skopiuj do infra/ansible/secrets.yml, uzupełnij realne wartości, a potem zaszyfruj:
#   ANSIBLE_PASSWORD=twoje-haslo make vault_encrypt
#
# NIGDY nie commituj niezaszyfrowanego infra/ansible/secrets.yml.
# Zaszyfrowany plik JEST przeznaczony do commitowania (ansible-vault ciphertext
# jest bezpieczny w git). Brak tu doppler_token — frontend nie ma żadnych
# sekretów runtime (URL backendu jest wpisany na stałe w src/app.ts).

git_pat: ""              # GitHub PAT z uprawnieniem read do repo, do klonowania po HTTPS
docker_hub_username: ""
docker_hub_password: ""  # Docker Hub access token (NIE hasło do konta)
sudo_password: ""        # hasło sudo na serwerze; puste = sudo NOPASSWD
